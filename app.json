{
  "expo": {
    "name": "Venture",
    "slug": "venture-app",
    "scheme": "venture",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#332B65"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.venturecollective.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Venture uses your location to show nearby activity sessions.",
        "NSCameraUsageDescription": "Venture needs camera access to upload your profile photo.",
        "NSPhotoLibraryUsageDescription": "Venture needs photo library access to upload your profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#332B65"
      },
      "package": "com.venturecollective.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/94921410-6f6f-4a2d-83cc-c8cbbac3d7aa",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-updates",
      "expo-font",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Venture to access your photos for profile pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FD4FE9"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "94921410-6f6f-4a2d-83cc-c8cbbac3d7aa"
      }
    },
    "owner": "ggregga"
  }
}
